{
	"name": "ui",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"sync-data": "node -e \"const f=require('fs'),d='src/lib/server/results.json';if(f.existsSync('../results/index.json'))f.copyFileSync('../results/index.json',d);else if(!f.existsSync(d))f.writeFileSync(d,JSON.stringify({generated:new Date(0).toISOString(),runs:[]}))\"",
		"prebuild": "npm run sync-data",
		"predev": "npm run sync-data"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^7.0.5",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.19.4",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	},
	"dependencies": {
		"@workos-inc/node": "^12.4.0"
	}
}
